# --- App ---
APP_NAME="Physics Educational Platform API"
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Database ---
DATABASE_URL=postgresql+psycopg2://physics_user:physics_pass@localhost:5432/physics_db

# --- Redis (optional, for caching / rate limiting / usage counters) ---
REDIS_URL=redis://localhost:6379/0

# --- AI ---
# The backend is the ONLY thing allowed to call this. Never expose it to the mobile app.
# Pointed at Gemini's free tier via its OpenAI-compatible endpoint by default — get a
# free key at https://aistudio.google.com/apikey (no credit card required).
# QWEN_API_KEY can be a single key OR several comma-separated keys, e.g.
#   QWEN_API_KEY=AQ.key-one,AQ.key-two,AQ.key-three
# Each free-tier key gets its own separate rate-limit quota (per Google Cloud
# project), so listing more than one gives the backend somewhere to fall
# back to when one key hits its per-minute quota — see qwen_client.py.
# A personal "Gemini Pro" subscription does NOT raise this quota; only
# enabling Cloud Billing on a project does (see
# ai.google.dev/gemini-api/docs/google-ai-plans).
QWEN_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
QWEN_API_KEY=change-me
QWEN_MODEL_NAME=gemini-flash-lite-latest

# --- Usage limits ---
AI_DAILY_REQUEST_LIMIT_FREE=20
AI_DAILY_REQUEST_LIMIT_PRO=500
