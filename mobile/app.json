{
  "expo": {
    "name": "Physics Platform",
    "slug": "physics-platform",
    "scheme": "physicsplatform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kaneki.physicsplatform",
      "adaptiveIcon": {
        "backgroundColor": "#05070C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق الوصول لمكتبة الصور عشان تختار فيديو المحاضرة أو تصوّر مسألة تسألها للمساعد الذكي.",
          "cameraPermission": "يحتاج التطبيق الوصول للكاميرا عشان تصوّر مسألة وتسألها للمساعد الذكي."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8b1a899-2d34-42a0-9541-6acc5243f571"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b8b1a899-2d34-42a0-9541-6acc5243f571"
    }
  }
}
